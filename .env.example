# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (use the pooler host; the app speaks the Neon HTTP driver)
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require

# Bearer token the /api/jobs/* routes require (also a GitHub Actions secret
# for the cron pinger). Generate: openssl rand -hex 32
CRON_SECRET=

# Owner access: /admin/* pages and the owner's paper-trading book.
# Also signs tester profile cookies. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Shared invite code testers type to create a paper-trading profile.
# Leave unset to disable sign-ups entirely.
INVITE_CODE=

# Claude API key for cross-platform event matching (job degrades gracefully
# to heuristic-only review queueing without it).
ANTHROPIC_API_KEY=

# Optional overrides
# PAPER_STARTING_BANKROLL=1000
# MIN_EXECUTABLE_USD=50
# SNAPSHOT_TOP_N=200
# CATALOG_SYNC_MAX_EVENTS=2000

# Paper auto-trader (admin-only). Start/Stop is now controlled by a button on
# /admin/auto-trader (persisted in the trading_sessions table); AUTO_TRADER_ENABLED
# is only the INITIAL default for a brand-new session (and the fallback before the
# 0003_trading_sessions migration is applied). The bot opens arbs above the min
# edge into a reserved bot book and closes early only on the triggers below.
# The bot opens each qualifying arb at most ONCE per session (no re-entry) and
# HOLDS to settlement by default — take-profit/stop-loss are opt-in (0 = off),
# since marking a hedged arb mid-life just books the bid/ask spread as a loss.
# AUTO_TRADER_ENABLED=1
# AUTO_TRADER_MIN_EDGE=0.02
# AUTO_TRADER_STAKE_USD=100
# AUTO_TRADER_MAX_OPEN=20
# AUTO_TRADER_TAKE_PROFIT_USD=0   # >0 to opt back in
# AUTO_TRADER_STOP_USD=0          # >0 to opt back in
# AUTO_TRADER_CLOSE_RULES_DIFFER=1
# Simple shared password for the /admin/auto-trader dashboard (linked from the
# nav). Now guards start/stop + a destructive clear, so set a non-default value
# in prod. Defaults to "hotham".
# AUTO_TRADER_PASSWORD=hotham
